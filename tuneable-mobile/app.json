{
  "expo": {
    "name": "Tuneable",
    "slug": "tuneable-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "stream.tuneable.app",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "stream.tuneable.app",
      "buildNumber": "1",
      "usesAppleSignIn": true,
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ],
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocationWhenInUseUsageDescription": "Tuneable uses your location so tips can influence charts where you are."
      }
    },
    "android": {
      "package": "stream.tuneable.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#1A1A2E",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "WAKE_LOCK"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-dev-client",
      "expo-apple-authentication",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#1A1A2E"
        }
      ],
      "expo-iap",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Tuneable uses your location so tips can influence charts where you are."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#6D28D9",
          "defaultChannel": "default"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Tuneable uses your photos so you can set a profile picture.",
          "cameraPermission": "Tuneable uses your camera so you can take a profile picture.",
          "microphonePermission": false
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiUrl": "http://localhost:8000",
      "defaultInviteCode": "PE856",
      "eas": {
        "projectId": "51cc8dd9-277c-4cf6-8a61-5e306a3b2388"
      },
      "router": {}
    },
    "owner": "tuneable"
  }
}
