# Copy to `.env` and adjust for your machine / device.
# Do not commit `.env`.

# API origin without `/api` — client appends `/api`.
EXPO_PUBLIC_API_URL=http://localhost:8000

# Prefills the register invite field (same default as web). Leave empty to require entry.
EXPO_PUBLIC_DEFAULT_INVITE_CODE=PE856

# EAS production/preview builds set EXPO_PUBLIC_API_URL=https://tuneable.stream in eas.json.
# For App Store / TestFlight builds, do not leave this as localhost.

# Sign in with Apple requires a development / store build (not Expo Go),
# plus Sign in with Apple capability on the App ID in Apple Developer.
# Wallet top-ups on iOS/Android use App Store / Play Billing (expo-iap).
# Stripe Checkout remains for web. Create these consumable products in both stores:
#   stream.tuneable.app.wallet.5
#   stream.tuneable.app.wallet.10
#   stream.tuneable.app.wallet.20
#   stream.tuneable.app.wallet.50
# IAP requires a development build / TestFlight / Play build (not Expo Go).
