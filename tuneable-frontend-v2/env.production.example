# Copy to .env.production.local for local production mobile builds (not committed).
# Used by: npm run cap:sync:prod

VITE_API_URL=https://tuneable.stream/api
VITE_BACKEND_URL=https://tuneable.stream

# Sign in with Apple (web) — same Services ID as backend APPLE_SERVICES_ID
# VITE_APPLE_CLIENT_ID=com.tuneable.web
# VITE_APPLE_REDIRECT_URI=https://tuneable.stream/auth/callback
