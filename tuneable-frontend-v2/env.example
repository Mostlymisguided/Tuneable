VITE_BACKEND_URL=http://localhost:8000
VITE_WEBSOCKET_URL=ws://localhost:8000
# Note: Stripe publishable key is now fetched dynamically from the backend API
# based on the AdminSettings stripe mode (test/live). No frontend env variable needed.

# Optional: default invite code pre-filled on the register page (e.g. PE856). Set to empty to require users to enter a code.
# VITE_DEFAULT_INVITE_CODE=PE856

# Sign in with Apple (web) — Services ID from Apple Developer → Identifiers → Services IDs
# Also set APPLE_SERVICES_ID (same value) on the backend so token audience verifies.
# Configure the Services ID with your web domain + Return URL:
#   https://localhost:5173/auth/callback (dev) and https://tuneable.stream/auth/callback (prod)
# VITE_APPLE_CLIENT_ID=com.tuneable.web
# Optional exact Return URL override (must match Apple console):
# VITE_APPLE_REDIRECT_URI=http://localhost:5173/auth/callback
